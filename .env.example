# Copier en .env puis adapter.
# Interface à surveiller. auto (défaut) : celle de la route par défaut, choisie au démarrage
# (la même que « dev … » dans `ip route get 1.1.1.1`). Un nom (eth0, wlp2s0…) la force.
EXFILDNS_INTERFACE=auto
# Durée de conservation des requêtes enregistrées, en jours
EXFILDNS_RETENTION=3
# Webhook des alertes hautes (service notifier, profil « notification ») : adresse qui reçoit
# un POST JSON dont le champ `text` est lu par Slack, Mattermost, Rocket.Chat…
# EXFILDNS_WEBHOOK=https://chat.exemple.fr/hooks/xxxxxxxx
# Fuseau horaire des heures affichées
TZ=Europe/Paris
# Mot de passe du dashboard (vide : accès libre, acceptable tant qu'il reste sur localhost)
EXFILDNS_MOT_DE_PASSE=
# Port local du dashboard (http://localhost:8501)
EXFILDNS_PORT=8501
