# Copier en .env puis adapter.
# Interface à surveiller : celle de la route par défaut, donnée par `ip route get 1.1.1.1`
# (« dev eth0 ») ; une autre interface ne verrait pas le trafic DNS du poste.
EXFILDNS_INTERFACE=eth0
# Fuseau horaire des heures affichées
TZ=Europe/Paris
# Port local du dashboard (http://localhost:8501)
EXFILDNS_PORT=8501
